# GitHub Personal Access Token
# Generate at: https://github.com/settings/tokens
# Required scopes: repo
GH_PAT=ghp_your_token_here

# Playwright browser path — only needed in Claude Code remote environments.
# Leave commented out for Google Colab, local installs, or anywhere you run
# `playwright install chromium` yourself.
# PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
